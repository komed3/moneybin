{
  "name": "moneybin",
  "private": true,
  "description": "Open-source net-worth tracking software",
  "version": "1.0.0",
  "license": "MIT",
  "author": {
    "name": "komed3 (Paul Köhler)",
    "email": "webmaster@komed3.de",
    "url": "https://komed3.de"
  },
  "homepage": "https://github.com/komed3/moneybin",
  "engines": {
    "node": ">=22.16.0"
  },
  "type": "module",
  "bin": {
    "moneybin": "dist/maintenance/run.js"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=dev tsx src/server/run.ts",
    "moneybin:dev": "tsx src/maintenance/run.ts",
    "build:server": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:client": "vite build",
    "format": "prettier --ignore-path \"\" --write \"dist/**/*.js\" --log-level warn",
    "build": "npm run build:server && npm run format && npm run build:client",
    "start": "cross-env NODE_ENV=production node dist/server/run.js",
    "moneybin": "node dist/maintenance/run.js"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-http-backend": "^4.0.10",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
